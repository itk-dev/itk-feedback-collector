{
  "name": "itk-dev/itk-feedback-collector",
  "description": "Itk Feedback Collector",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^3.3.4",
    "doctrine/doctrine-migrations-bundle": "^4.0.1",
    "doctrine/orm": "^3.7.5",
    "stof/doctrine-extensions-bundle": "^1.15.3",
    "symfony/asset": "~7.4.8",
    "symfony/console": "~7.4.22",
    "symfony/dotenv": "~7.4.18",
    "symfony/flex": "^2.11",
    "symfony/form": "~7.4.22",
    "symfony/framework-bundle": "~7.4.22",
    "symfony/http-client": "~7.4.22",
    "symfony/rate-limiter": "~7.4.22",
    "symfony/runtime": "~7.4.22",
    "symfony/security-bundle": "~7.4.22",
    "symfony/translation": "~7.4.22",
    "symfony/twig-bundle": "~7.4.21",
    "symfony/uid": "~7.4.21",
    "symfony/validator": "~7.4.22",
    "symfony/yaml": "~7.4.22"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3.1",
    "ergebnis/composer-normalize": "^2.54",
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "symfony/maker-bundle": "^1.68",
    "vincentlanglet/twig-cs-fixer": "^3.14"
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
