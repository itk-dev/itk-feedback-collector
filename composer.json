{
    "name": "itk-dev/tidy-feedback-collector",
    "description": "Tidy Feedback Collector",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.3",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/asset": "~7.4.0",
        "symfony/console": "~7.4.0",
        "symfony/dotenv": "~7.4.0",
        "symfony/flex": "^2.10",
        "symfony/form": "~7.4.0",
        "symfony/framework-bundle": "~7.4.0",
        "symfony/http-client": "~7.4.0",
        "symfony/rate-limiter": "~7.4.0",
        "symfony/runtime": "~7.4.0",
        "symfony/security-bundle": "~7.4.0",
        "symfony/translation": "~7.4.0",
        "symfony/twig-bundle": "~7.4.0",
        "symfony/uid": "~7.4.0",
        "symfony/validator": "~7.4.0",
        "symfony/yaml": "~7.4.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "symfony/maker-bundle": "^1.67",
        "vincentlanglet/twig-cs-fixer": "^3.14"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
