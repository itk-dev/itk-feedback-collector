{% extends 'base.html.twig' %}

{% block title %}Feedback for {{ website.websiteId }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold text-ink mb-2">Feedback for {{ website.websiteId }}</h1>
    <p class="text-slate-500 mb-4">{{ website.url }}</p>
    <p class="mb-5"><a href="{{ path('app_index') }}">Back to website selection</a></p>

    <div class="bg-paper rounded-3 shadow-2 overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-slate-50 text-left text-slate-700 font-medium">
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Data</th>
                    <th class="px-4 py-3">Created At</th>
                </tr>
            </thead>
            <tbody>
                {% for feedback in feedbacks %}
                    <tr class="border-t border-slate-200">
                        <td class="px-4 py-3 font-mono text-xs text-slate-500">{{ feedback.id }}</td>
                        <td class="px-4 py-3 font-mono text-xs">{{ feedback.data|json_encode }}</td>
                        <td class="px-4 py-3 text-slate-500">{{ feedback.createdAt|date('Y-m-d H:i:s') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="px-4 py-5 text-center text-slate-500">No feedback found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
