{% extends 'base.html.twig' %}

{% block title %}Select Website{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold text-ink mb-5">Select a Website</h1>
    <form method="get" action="{{ path('app_index') }}" class="bg-paper rounded-3 shadow-2 p-5 max-w-lg">
        <label for="website-select" class="block text-sm font-medium text-ink-soft mb-2">Website</label>
        <select name="website" id="website-select" required
                class="w-full px-3 py-2 border border-slate-300 rounded-2 text-base text-ink bg-paper focus-visible:shadow-focus mb-4">
            <option value="">-- Choose a website --</option>
            {% for website in websites %}
                <option value="{{ website.id }}">{{ website.websiteId }} ({{ website.url }})</option>
            {% endfor %}
        </select>
        <button type="submit"
                class="bg-primary text-paper px-5 py-2 rounded-2 font-medium hover:bg-primary-hover no-underline">
            View Feedback
        </button>
    </form>
{% endblock %}
