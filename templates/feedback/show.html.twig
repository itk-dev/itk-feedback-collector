{% extends 'base.html.twig' %}

{% block title %}{{ 'Feedback Detail'|trans }} — {{ feedback.data.created_by ?? feedback.id }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-ink">{{ 'Feedback Detail'|trans }}</h1>
            {% if feedback.handled %}
                <span class="bg-green/10 text-green border border-green/30 px-3 py-1 rounded-pill text-xs font-medium">{{ 'Handled'|trans }}</span>
            {% endif %}
        </div>
        <div class="flex gap-3">
            {% if not feedback.handled %}
                {% if feedback.website.freescoutMailboxId %}
                    <form method="post" action="{{ path('app_feedback_report', {id: feedback.id}) }}">
                        <button type="submit" class="bg-primary text-paper px-4 py-2 rounded-2 text-sm font-medium hover:bg-primary-hover no-underline cursor-pointer border-none">{{ 'Report as bug'|trans }}</button>
                    </form>
                {% else %}
                    <button type="button" class="bg-primary text-paper px-4 py-2 rounded-2 text-sm font-medium no-underline border-none opacity-50 cursor-not-allowed" disabled title="{{ 'No FreeScout mailbox configured'|trans }}">{{ 'Report as bug'|trans }}</button>
                {% endif %}
                <button type="button" class="bg-primary text-paper px-4 py-2 rounded-2 text-sm font-medium hover:bg-primary-hover no-underline cursor-pointer border-none" disabled>{{ 'Create feature request'|trans }}</button>
            {% endif %}
            <form method="post" action="{{ path('app_feedback_delete', {id: feedback.id}) }}"
                  onsubmit="return confirm('{{ 'Delete this feedback?'|trans }}')">
                <button type="submit" class="bg-error text-paper px-4 py-2 rounded-2 text-sm font-medium cursor-pointer border-none hover:opacity-80">{{ 'Delete'|trans }}</button>
            </form>
        </div>
    </div>
    <p class="mb-5 text-sm"><a href="{{ path('app_website_show', {id: feedback.website.id}) }}">← {{ 'Back to'|trans }} {{ feedback.website.websiteId }}</a></p>

    {% for flash in app.flashes('success') %}
        <div class="bg-green/10 border border-green/30 text-green rounded-2 px-4 py-3 mb-4">{{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('error') %}
        <div class="bg-error/10 border border-error/30 text-error rounded-2 px-4 py-3 mb-4">{{ flash }}</div>
    {% endfor %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="bg-paper rounded-3 shadow-2 overflow-hidden">
            <table class="w-full text-sm">
                <tr class="border-b border-slate-200">
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50 w-40">{{ 'Created By'|trans }}</th>
                    <td class="px-4 py-3">{{ feedback.data.created_by ?? '—' }}</td>
                </tr>
                <tr class="border-b border-slate-200">
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Description'|trans }}</th>
                    <td class="px-4 py-3">{{ feedback.data.description ?? '—' }}</td>
                </tr>
                <tr class="border-b border-slate-200">
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Created At'|trans }}</th>
                    <td class="px-4 py-3 text-slate-500">{{ feedback.createdAt|date('d-m-Y H:i:s') }}</td>
                </tr>
                {% if feedback.data.context is defined %}
                    <tr class="border-b border-slate-200">
                        <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Page URL'|trans }}</th>
                        <td class="px-4 py-3 font-mono text-xs break-all">{{ feedback.data.context.url ?? '—' }}</td>
                    </tr>
                    <tr class="border-b border-slate-200">
                        <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'User Agent'|trans }}</th>
                        <td class="px-4 py-3 font-mono text-xs">{{ feedback.data.context.navigator.userAgent ?? '—' }}</td>
                    </tr>
                    <tr class="border-b border-slate-200">
                        <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Window Size'|trans }}</th>
                        <td class="px-4 py-3 font-mono text-xs">
                            {% if feedback.data.context.window is defined %}
                                {{ feedback.data.context.window.innerWidth }} × {{ feedback.data.context.window.innerHeight }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                    </tr>
                    {% if feedback.data.context.selectedElement is defined and feedback.data.context.selectedElement %}
                        <tr class="border-b border-slate-200">
                            <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Selected Element'|trans }}</th>
                            <td class="px-4 py-3 font-mono text-xs">{{ feedback.data.context.selectedElement }}</td>
                        </tr>
                    {% endif %}
                    {% if feedback.data.context.referrer is defined and feedback.data.context.referrer %}
                        <tr class="border-b border-slate-200">
                            <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Referrer'|trans }}</th>
                            <td class="px-4 py-3 font-mono text-xs break-all">{{ feedback.data.context.referrer }}</td>
                        </tr>
                    {% endif %}
                {% endif %}
            </table>
        </div>

        <div class="bg-paper rounded-3 shadow-2 p-4">
            {% if feedback.data.image is defined and feedback.data.image %}
                <img src="{{ feedback.data.image }}" alt="{{ 'Screenshot'|trans }}" class="w-full rounded-2 border border-slate-200 cursor-pointer" onclick="document.getElementById('screenshot-overlay').hidden=false">
            {% else %}
                <p class="text-slate-500 text-center py-7">{{ 'No screenshot available.'|trans }}</p>
            {% endif %}
        </div>
    </div>

    <div class="bg-paper rounded-3 shadow-2 p-5 mb-6">
        <form method="post" action="{{ path('app_feedback_note', {id: feedback.id}) }}">
            <label for="note" class="block text-sm font-medium text-ink-soft mb-2">{{ 'Note'|trans }}</label>
            <textarea name="note" id="note" rows="4"
                      class="w-full px-3 py-2 border border-slate-300 rounded-2 text-base text-ink bg-paper mb-3"
                      placeholder="{{ 'Add a note for this feedback...'|trans }}">{{ feedback.note }}</textarea>
            <button type="submit" class="bg-primary text-paper px-4 py-2 rounded-2 text-sm font-medium hover:bg-primary-hover no-underline cursor-pointer border-none">{{ 'Save note'|trans }}</button>
        </form>
    </div>

    <details class="bg-paper rounded-3 shadow-2 mb-6">
        <summary class="px-4 py-3 cursor-pointer font-medium text-sm text-slate-700 select-none">{{ 'Raw JSON data'|trans }}</summary>
        <pre class="px-4 py-3 border-t border-slate-200 overflow-x-auto text-xs font-mono text-slate-500"><code>{{ feedback.data|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
    </details>

    {% if feedback.data.image is defined and feedback.data.image %}
        <div id="screenshot-overlay" hidden
             class="fixed inset-0 z-50 bg-ink/90 flex items-center justify-center cursor-pointer p-6"
             onclick="this.hidden=true">
            <img src="{{ feedback.data.image }}" alt="{{ 'Screenshot'|trans }}" class="max-w-full max-h-full rounded-3 shadow-3">
        </div>
    {% endif %}

{% endblock %}
