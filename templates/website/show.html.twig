{% extends 'base.html.twig' %}

{% block title %}Website: {{ website.websiteId }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold text-ink mb-5">{{ website.websiteId }}</h1>

    {% for flash in app.flashes('success') %}
        <div class="bg-green/10 border border-green/30 text-green rounded-2 px-4 py-3 mb-4">
            {{ flash }}
        </div>
    {% endfor %}

    <div class="bg-paper rounded-3 shadow-2 overflow-hidden mb-6">
        <table class="w-full text-sm">
            <tr class="border-b border-slate-200">
                <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50 w-32">URL</th>
                <td class="px-4 py-3">{{ website.url }}</td>
            </tr>
            <tr class="border-b border-slate-200">
                <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">API Key</th>
                <td class="px-4 py-3"><code class="font-mono text-xs bg-slate-100 px-2 py-1 rounded-1">{{ website.apiKey }}</code></td>
            </tr>
            <tr>
                <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">Created</th>
                <td class="px-4 py-3 text-slate-500">{{ website.createdAt|date('Y-m-d H:i:s') }}</td>
            </tr>
        </table>
    </div>

    <h2 class="text-xl font-bold text-ink mb-3">Embed Script</h2>
    <p class="text-slate-500 mb-3">Add this snippet to the website's HTML to enable the feedback widget:</p>
    <pre class="bg-ink text-slate-300 rounded-2 p-4 overflow-x-auto text-xs font-mono mb-6"><code>&lt;script src="{{ apiEndpoint | replace({'/api/feedback': ''}) }}/build/widget/widget.js"
        data-endpoint="{{ apiEndpoint }}"
        data-api-key="{{ website.apiKey }}"&gt;&lt;/script&gt;</code></pre>

    <h2 class="text-xl font-bold text-ink mb-3">Feedback ({{ feedbacks|length }})</h2>
    <div class="bg-paper rounded-3 shadow-2 overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-slate-50 text-left text-slate-700 font-medium">
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Data</th>
                    <th class="px-4 py-3">Created At</th>
                </tr>
            </thead>
            <tbody>
                {% for feedback in feedbacks %}
                    <tr class="border-t border-slate-200">
                        <td class="px-4 py-3 font-mono text-xs text-slate-500">{{ feedback.id }}</td>
                        <td class="px-4 py-3 font-mono text-xs">{{ feedback.data|json_encode }}</td>
                        <td class="px-4 py-3 text-slate-500">{{ feedback.createdAt|date('Y-m-d H:i:s') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="px-4 py-5 text-center text-slate-500">No feedback found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="flex gap-4 text-sm">
        <a href="{{ path('app_admin_website_create') }}">Create another website</a>
        <a href="{{ path('app_index') }}">Back to home</a>
    </div>
{% endblock %}
