{% extends 'base.html.twig' %}

{% block title %}{{ 'Website'|trans }}: {{ website.websiteId }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold text-ink mb-2">{{ website.websiteId }}</h1>
    <p class="mb-5 text-sm"><a href="{{ path('app_index') }}">← {{ 'Back to home'|trans }}</a></p>

    {% for flash in app.flashes('success') %}
        <div class="bg-green/10 border border-green/30 text-green rounded-2 px-4 py-3 mb-4">
            {{ flash|trans }}
        </div>
    {% endfor %}

    <details class="bg-paper rounded-3 shadow-2 mb-6">
        <summary class="px-4 py-3 cursor-pointer font-medium text-sm text-slate-700 select-none">{{ 'Website details & embed script'|trans }}</summary>
        <div class="border-t border-slate-200">
            <table class="w-full text-sm">
                <tr class="border-b border-slate-200">
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50 w-32">{{ 'URL'|trans }}</th>
                    <td class="px-4 py-3">{{ website.url }}</td>
                </tr>
                <tr class="border-b border-slate-200">
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'API Key'|trans }}</th>
                    <td class="px-4 py-3"><code class="font-mono text-xs bg-slate-100 px-2 py-1 rounded-1">{{ website.apiKey }}</code></td>
                </tr>
                <tr class="border-b border-slate-200">
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50">{{ 'Created'|trans }}</th>
                    <td class="px-4 py-3 text-slate-500">{{ website.createdAt|date('d-m-Y H:i:s') }}</td>
                </tr>
                <tr>
                    <th class="px-4 py-3 text-left text-slate-700 font-medium bg-slate-50 align-top">{{ 'Embed Script'|trans }}</th>
                    <td class="px-4 py-3">
                        <pre class="bg-ink text-slate-300 rounded-2 p-4 overflow-x-auto text-xs font-mono"><code>&lt;script src="{{ apiEndpoint | replace({'/api/feedback': ''}) }}/build/widget/widget.js"
        data-endpoint="{{ apiEndpoint }}"
        data-api-key="{{ website.apiKey }}"&gt;&lt;/script&gt;</code></pre>
                    </td>
                </tr>
            </table>
        </div>
    </details>

    <h2 class="text-xl font-bold text-ink mb-3">{{ 'Feedback'|trans }} ({{ feedbacks|length }})</h2>
    <div class="bg-paper rounded-3 shadow-2 overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-slate-50 text-left text-slate-700 font-medium">
                    <th class="px-4 py-3">{{ 'Created By'|trans }}</th>
                    <th class="px-4 py-3">{{ 'Description'|trans }}</th>
                    <th class="px-4 py-3">{{ 'Created At'|trans }}</th>
                    <th class="px-4 py-3 text-center">{{ 'Actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for feedback in feedbacks %}
                    <tr class="border-t border-slate-200">
                        <td class="px-4 py-3">{{ feedback.data.created_by ?? '—' }}</td>
                        <td class="px-4 py-3 max-w-xs truncate">{{ feedback.data.description ?? '—' }}</td>
                        <td class="px-4 py-3 text-slate-500">{{ feedback.createdAt|date('d-m-Y H:i:s') }}</td>
                        <td class="px-4 py-3 text-center">
                            <div class="inline-flex items-center gap-3">
                                <a href="{{ path('app_feedback_show', {id: feedback.id}) }}">{{ 'Show'|trans }}</a>
                                <form method="post" action="{{ path('app_feedback_delete', {id: feedback.id}) }}"
                                      onsubmit="return confirm('{{ 'Delete this feedback?'|trans }}')">
                                    <button type="submit" class="text-error underline text-sm bg-transparent border-none cursor-pointer p-0">{{ 'Delete'|trans }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-4 py-5 text-center text-slate-500">{{ 'No feedback found.'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
