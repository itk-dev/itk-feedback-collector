{% extends 'base.html.twig' %}

{% block title %}{{ 'Manage Websites'|trans }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold text-ink mb-2">{{ 'Manage Websites'|trans }}</h1>
    <p class="mb-5 text-sm"><a href="{{ path('app_index') }}">← {{ 'Back to home'|trans }}</a></p>

    <div class="bg-paper rounded-3 shadow-2 overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-slate-50 text-left text-slate-700 font-medium">
                    <th class="px-4 py-3">{{ 'Name'|trans }}</th>
                    <th class="px-4 py-3">{{ 'URL'|trans }}</th>
                    <th class="px-4 py-3 text-center">{{ 'Actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for website in websites %}
                    <tr class="border-t border-slate-200">
                        <td class="px-4 py-3">{{ website.websiteId }}</td>
                        <td class="px-4 py-3 text-slate-500">{{ website.url }}</td>
                        <td class="px-4 py-3 text-center">
                            <a href="{{ path('app_admin_website_edit', {id: website.id}) }}">{{ 'Edit'|trans }}</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="px-4 py-5 text-center text-slate-500">{{ 'No websites found.'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <p><a href="{{ path('app_admin_website_create') }}">{{ 'Create new website'|trans }}</a></p>
{% endblock %}
