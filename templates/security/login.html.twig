{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto mt-20">
        <h1 class="text-2xl font-bold mb-6">Log in</h1>

        {% if error %}
            <div class="bg-red-100 text-red-800 px-4 py-3 rounded-2 mb-4 text-sm">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div class="mb-4">
                <label for="input-email" class="block text-sm font-medium mb-1">Email</label>
                <input type="email" id="input-email" name="_username" value="{{ last_username }}" required autofocus
                       class="w-full px-3 py-2 border border-muted rounded-2 text-sm">
            </div>

            <div class="mb-6">
                <label for="input-password" class="block text-sm font-medium mb-1">Password</label>
                <input type="password" id="input-password" name="_password" required
                       class="w-full px-3 py-2 border border-muted rounded-2 text-sm">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full bg-primary text-paper px-4 py-2 rounded-2 text-sm font-medium">
                Log in
            </button>
        </form>
    </div>
{% endblock %}
